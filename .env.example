# Cấu hình danh tính Agent (Bắt buộc cho từng nhóm)
AGENT_ID=travel-hanoi-g07
GROUP_ID=g07

# Địa chỉ endpoint công khai (IP máy trong mạng LAN hoặc domain)
# Dùng http://localhost:8000 khi chạy local máy mình
# Dùng http://<IP_LAN_CỦA_BẠN>:8000 khi kết nối với máy nhóm khác
PUBLIC_URL=http://localhost:8000

# Đường dẫn file tri thức gốc
KNOWLEDGE_PATH=data/hanoi_places.json

# Cổng lắng nghe máy chủ
HOST=0.0.0.0
PORT=8000

# Cấu hình Registry (dùng cho Milestone M3)
# REGISTRY_IMPL=static_file
# REGISTRY_URL=http://192.168.1.100:8500
